# AutoAudit-360: Environment Variables Configuration Template
# Copy this file to .env for local configuration

# Server Port (Render/Cloud Run dynamically provide PORT)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Python Binary path (e.g. 'python', 'python3', or path to virtualenv)
PYTHON_BIN=python

# Security policy: Disallow arbitrary untrusted pickle/joblib deserialization in public web processes
ALLOW_MODEL_UPLOAD=false

# CORS Allowed Origins ('*' or specific frontend domain)
CORS_ORIGIN=*

# Optional Gemini API Key (if interacting with AI Studio applet)
# AI Studio automatically injects this at runtime from secrets
GEMINI_API_KEY=""

# Public deployment URL
APP_URL="https://autoaudit-360.onrender.com"
